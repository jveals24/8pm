<footer class="site-footer" role="contentinfo">
  <div class="container footer-grid">
    <div>
      <img src="/assets/images/logo-transparent.png" alt="{{ site.name }} full logo" class="footer-logo">
      <p class="footer-ministry-name">{{ site.name }}</p>
      <p>{{ site.tagline }}</p>
    </div>
    <div>
      <h2 class="footer-heading">Connect</h2>
      <ul class="footer-list">
        <li><a href="{{ site.social.instagram }}">Instagram</a></li>
        <li><a href="{{ site.social.facebook }}">Facebook</a></li>
        <li><a href="{{ site.social.youtube }}">YouTube</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-heading">Contact</h2>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p>Online ministry with livestream and in-person event support.</p>
    </div>
  </div>
</footer>
