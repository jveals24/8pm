---
layout: layouts/base.njk
title: Blog
permalink: /blog/
---
<section class="page-header">
  <div class="container">
    <h1>Blog</h1>
    <p class="lead">Use this section for searchable teaching content connected to healing, discipleship, and Bible study.</p>
  </div>
</section>
<section class="section">
  <div class="container">
    <ul class="blog-list">
      {% for post in collections.blog | reverse %}
      <li class="card">
        <p class="blog-meta">{{ post.date | displayDate }}</p>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.excerpt }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
