---
layout: layouts/base.njk
title: Invite a Speaker
permalink: /invite-a-speaker/
---
<section class="page-header">
  <div class="container">
    <h1>Invite a Speaker</h1>
    <p class="lead">A custom intake form modeled after the kind of church event request form you referenced, built directly into the site.</p>
  </div>
</section>
<section class="section">
  <div class="container form-panel">
    <form name="speaker-request" method="post" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="speaker-request">
      <p class="visually-hidden"><label>Do not fill this out if you are human <input name="bot-field"></label></p>
      <div class="form-grid">
        <div>
          <label for="organization">Church or organization</label>
          <input id="organization" name="organization" required>
        </div>
        <div>
          <label for="contact-name">Primary contact name</label>
          <input id="contact-name" name="contact_name" autocomplete="name" required>
        </div>
      </div>
      <div class="form-grid">
        <div>
          <label for="contact-email">Email address</label>
          <input id="contact-email" name="contact_email" type="email" autocomplete="email" required>
        </div>
        <div>
          <label for="contact-phone">Phone number</label>
          <input id="contact-phone" name="contact_phone" type="tel" autocomplete="tel">
        </div>
      </div>
      <div class="form-grid">
        <div>
          <label for="event-type">Event type</label>
          <select id="event-type" name="event_type">
            <option>Healing service</option>
            <option>Conference or revival</option>
            <option>Sunday service</option>
            <option>Bible study or teaching event</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <label for="attendance">Expected attendance</label>
          <input id="attendance" name="attendance">
        </div>
      </div>
      <div class="form-grid">
        <div>
          <label for="event-date">Requested date</label>
          <input id="event-date" name="event_date" type="date">
        </div>
        <div>
          <label for="location">Event location</label>
          <input id="location" name="location">
        </div>
      </div>
      <div>
        <label for="event-details">Event details</label>
        <textarea id="event-details" name="event_details"></textarea>
      </div>
      <div>
        <label for="media-needs">Audio, video, livestream, or ministry support needs</label>
        <textarea id="media-needs" name="media_needs"></textarea>
      </div>
      <input type="submit" value="Submit request">
    </form>
  </div>
</section>
